# Production values: provide these through your deployment secret manager.
NODE_ENV=production
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-characters
ADMIN_EMAIL=admin@goldenagro.com
ADMIN_PASSWORD=replace-with-a-very-strong-admin-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=https://your-frontend.vercel.app
PORT=5000
DB_SSL=true
ALLOW_MEMORY_DB=false
SEED_DEFAULT_USERS=false
