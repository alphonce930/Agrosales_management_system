# Production values: provide these through your deployment secret manager.
NODE_ENV=production
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-characters
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@goldenagro.com
ADMIN_PASSWORD=replace-with-a-very-strong-admin-password
SUPER_ADMIN_EMAIL=superadmin@goldenagro.com
SUPER_ADMIN_PASSWORD=replace-with-a-very-strong-super-admin-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=https://your-frontend.vercel.app
PORT=5000
DB_SSL=true
DB_CONNECTION_LIMIT=5
DB_IDLE_TIMEOUT_MS=30000
ALLOW_MEMORY_DB=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=5m
IP_RATE_LIMIT=20
IP_RATE_WINDOW=5m
IDEMPOTENCY_TTL_SECONDS=86400
SEED_DEFAULT_USERS=false
