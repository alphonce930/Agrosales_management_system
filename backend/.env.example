DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=golden_agrochemicals
DATABASE_URL=mysql://root:your_password@localhost:3306/golden_agrochemicals
JWT_SECRET=replace_with_long_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
PORT=5000
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10
DB_CONNECT_TIMEOUT_MS=5000
# Enable only for local UI demos without MySQL. This store is not persistent.
ALLOW_MEMORY_DB=false
# For Neon/Vercel, replace the MySQL DATABASE_URL above with the pooled Neon
# PostgreSQL connection string. The backend selects PostgreSQL automatically.
