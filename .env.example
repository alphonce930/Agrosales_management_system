DATABASE_URL=postgresql://postgres:postgres@localhost:5432/golden_agrochemicals
JWT_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@goldenagro.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SUPER_ADMIN_EMAIL=superadmin@goldenagro.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separate exact trusted frontend origins when using preview deployments.
FRONTEND_URL=http://localhost:5173
PORT=5000
DB_SSL=false
DB_CONNECTION_LIMIT=5
DB_IDLE_TIMEOUT_MS=30000
ALLOW_MEMORY_DB=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use "lax" for same-site local development and "none" for separate HTTPS
# frontend/backend origins. "none" requires HTTPS.
REFRESH_COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=5m
IP_RATE_LIMIT=100
IP_RATE_WINDOW=5m
IDEMPOTENCY_TTL_SECONDS=86400
SEED_DEFAULT_USERS=false
